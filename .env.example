# ============================================================
# Emmanuel Mantey Portfolio — Backend Environment Variables
# ------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file to Git (it is gitignored).
# ============================================================

# --- Server ---------------------------------------------------
# Port the Express server listens on
PORT=5000

# production | development  (production hides stack traces)
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# Leave empty for same-origin deployments (recommended).
# Example: ALLOWED_ORIGINS=https://www.your-domain.com,https://your-domain.com
ALLOWED_ORIGINS=

# How many contact submissions one IP may send per hour
CONTACT_RATE_LIMIT=5

# --- Email delivery (SMTP) ------------------------------------
# Set EMAIL_ENABLED=false to queue messages into
# backend/data/submissions.jsonl instead of sending email.
EMAIL_ENABLED=false

# Requires a transactional SMTP account. Two working options:
#  A) Gmail App Password (recipient is a Gmail mailbox):
#     enable 2-Step Verification → create an App password → use it
#     as SMTP_PASS, with SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
#     SMTP_SECURE=true.
#  B) A transactional provider (Brevo, Mailgun, SendGrid, Hostinger
#     Email): use their SMTP host/credentials. Use app-specific
#     credentials, never your personal login password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Where submissions are delivered — owner-confirmed mailbox
CONTACT_TO_EMAIL=jheskinmantey24@gmail.com
# Sender shown on delivered emails — must be a mailbox you own
# (or an authenticated sender address from your SMTP provider)
CONTACT_FROM_EMAIL=jheskinmantey24@gmail.com
